@@ -0,0 +1,69 @@
+import userModel from "../models/user.js";
+
+/**
+ * Home Assistant auth_api login helper.
+ *
+ * Only active when running as a Home Assistant app: the Supervisor injects
+ * a SUPERVISOR_TOKEN into every app container, and its presence is what
+ * enables this fallback. In every other environment it is inert and password
+ * login behaves exactly like stock NPMplus.
+ */
+const isEnabled = () => !!process.env.SUPERVISOR_TOKEN;
+
+/**
+ * Verifies credentials against the Home Assistant Supervisor auth_api and,
+ * on success, maps the login to the first enabled NPMplus admin user.
+ *
+ * @param   {String} identity
+ * @param   {String} secret
+ * @returns {Promise<Object|null>} the mapped NPMplus user, or null
+ */
+const loginWithHomeAssistant = async (identity, secret) => {
+	if (!isEnabled()) {
+		return null;
+	}
+
+	let response;
+	try {
+		response = await fetch("http://supervisor/auth", {
+			method: "POST",
+			headers: {
+				Authorization: `Bearer ${process.env.SUPERVISOR_TOKEN}`,
+				"Content-Type": "application/json",
+			},
+			body: JSON.stringify({
+				username: identity,
+				password: secret,
+			}),
+		});
+	} catch (err) {
+		console.warn("ha-auth: Home Assistant auth_api request failed:", err?.message ?? err);
+		return null;
+	}
+
+	if (response.status === 401) {
+		// Home Assistant rejected the credentials
+		return null;
+	}
+	if (!response.ok) {
+		console.warn(`ha-auth: Home Assistant auth_api returned status ${response.status}. Is "auth_api: true" set in the app config?`);
+		return null;
+	}
+
+	// A successful HA login maps to the first enabled NPMplus admin user,
+	// since auth_api does not tell us which HA user just signed in.
+	const users = await userModel.query().where("is_deleted", 0).andWhere("is_disabled", 0).orderBy("id");
+	const admin = users.find((u) => Array.isArray(u.roles) && u.roles.indexOf("admin") !== -1);
+
+	if (!admin) {
+		console.warn("ha-auth: Home Assistant accepted the login, but no enabled NPMplus admin user exists to map it to");
+		return null;
+	}
+
+	console.log(`ha-auth: Home Assistant login mapped to admin user id ${admin.id}`);
+	return admin;
+};
+
+export default {
+	loginWithHomeAssistant,
+};
