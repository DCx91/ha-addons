#!/command/with-contenv bashio
set -euo pipefail

tz="$(bashio::info.timezone || echo 'UTC')"

if bashio::fs.file_non_empty "/usr/share/zoneinfo/${tz}"; then
    ln -sf "/usr/share/zoneinfo/${tz}" /etc/localtime
else
    bashio::log.warning "Timezone '${tz}' not found in /usr/share/zoneinfo; leaving /etc/localtime unchanged"
fi

# --- HA config UI settings ---

env_tmp="$(mktemp /data/.env.XXXXXX)"
trap 'rm -f "${env_tmp}"' EXIT
{
    printf 'TZ=%q\n' "${tz}"
    printf 'DISABLE_IPV6=%q\n' "$(bashio::config 'disable_ipv6' 'false')"
    printf 'LOGROTATE=%q\n' "$(bashio::config 'logrotate' 'false')"
    printf 'TRUST_CLOUDFLARE=%q\n' "$(bashio::config 'trust_cloudflare' 'false')"
} > "${env_tmp}"

if bashio::config.has_value 'acme_email'; then
    export ACME_EMAIL="$(bashio::config 'acme_email')"
fi

# --- Persistent cookie secret ---
secret_file=/data/npmplus/cookie_secret
mkdir -p /data/npmplus
if ! bashio::fs.file_non_empty "${secret_file}"; then
    bashio::log.info "Generating new cookie secret"
    if ! openssl rand -hex 32 > "${secret_file}"; then
        rm -f "${secret_file}" "${env_tmp}"
        bashio::exit.nok "Failed to generate cookie secret (is openssl installed?)"
    fi
    chmod 600 "${secret_file}"
fi

secret="$(cat "${secret_file}")"

printf 'COOKIE_SECRET=%q\n' "${secret}" >> "${env_tmp}"
export COOKIE_SECRET="${secret}"

# --- Managed self-signed cert for the admin UI -----------------------------
admin_cn="$(bashio::host.hostname)"
if bashio::var.has_value "${admin_cn}"; then
    cert_dir="/data/tls/custom/npm-100"
    mkdir -p "${cert_dir}"
    if ! bashio::fs.file_non_empty "${cert_dir}/fullchain.pem" || \
       ! openssl x509 -in "${cert_dir}/fullchain.pem" -noout -ext subjectAltName 2>/dev/null \
            | grep -q "DNS:${admin_cn},"; then
        bashio::log.info "Generating self-signed admin certificate for ${admin_cn}"
        openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:secp384r1 -sha384 -nodes \
            -days 825 -subj "/CN=${admin_cn}" \
            -addext "subjectAltName=DNS:${admin_cn}" \
            -keyout "${cert_dir}/privkey.pem" \
            -out "${cert_dir}/fullchain.pem"
    else
        bashio::log.info "Admin certificate for ${admin_cn} already present"
    fi
    echo 'DEFAULT_CERT_ID=100' >>"${env_tmp}"
fi

# --- MaxMind GeoIP2 ---
GEOIP_SRC=/config/geoip2
GEOIP_DB="${GEOIP_SRC}/GeoLite2-Country.mmdb"
GEOIP2_USER_CONF="${GEOIP_SRC}/geoip2.conf"
GEOIP2_CONF=/data/custom_nginx/geoip2.conf
mkdir -p /data/custom_nginx

sed -i '/# BEGIN HA ADD-ON MANAGED/,/# END HA ADD-ON MANAGED/d' \
    /data/custom_nginx/http_top.conf \
    /data/custom_nginx/server_http.conf 2>/dev/null || true

if bashio::config.true 'geoip2'; then
    if bashio::fs.file_non_empty "${GEOIP_DB}"; then
        printf 'NGINX_LOAD_GEOIP2_MODULE=true\n' >> "${env_tmp}"

        if ! bashio::fs.file_exists "${GEOIP2_USER_CONF}"; then
            bashio::log.info "Creating default GeoIP2 config at ${GEOIP2_USER_CONF}"
            cat > "${GEOIP2_USER_CONF}" <<'EOF'
geoip2 /config/geoip2/GeoLite2-Country.mmdb {
    auto_reload 5m;
    $geoip2_data_country_code default=XX source=$remote_addr country iso_code;
}
map $geoip2_data_country_code $allowed_country {
    default yes;
}
EOF
        fi
        cp -f "${GEOIP2_USER_CONF}" "${GEOIP2_CONF}"
        {
            echo "# BEGIN HA ADD-ON MANAGED"
            echo "include ${GEOIP2_CONF};"
            echo "# END HA ADD-ON MANAGED"
        } >> /data/custom_nginx/http_top.conf
        {
            echo "# BEGIN HA ADD-ON MANAGED"
            echo 'if ($allowed_country = no) { return 403; }'
            echo "# END HA ADD-ON MANAGED"
        } >> /data/custom_nginx/server_http.conf
    else
        bashio::log.warning "GeoIP2 enabled but ${GEOIP_DB} not found at ${GEOIP_SRC} - module will not load"
        mkdir -p "${GEOIP_SRC}"
        printf 'NGINX_LOAD_GEOIP2_MODULE=false\n' >> "${env_tmp}"
    fi
else
    printf 'NGINX_LOAD_GEOIP2_MODULE=false\n' >> "${env_tmp}"
fi

mv "${env_tmp}" /data/.env
rm -f /tmp/env.sha512sum

# --- Create initial admin account ---
bashio::config.has_value 'initial_admin_email' && admin_email="$(bashio::config 'initial_admin_email')" || admin_email="admin@npmplus.local"

if ! bashio::config.has_value 'initial_admin_password'; then
    pass_file=/data/npmplus/initial_admin_password
    if ! bashio::fs.file_non_empty "${pass_file}"; then
        bashio::log.info "Generating initial admin password"
        openssl rand -hex 32 > "${pass_file}" \
            || bashio::exit.nok "Failed to generate initial admin password"
        chmod 600 "${pass_file}"
    fi
    admin_pass="$(cat "${pass_file}")"
    bashio::log.info "Initial admin: ${admin_email} (password stored at ${pass_file})"
else
    admin_pass="$(bashio::config 'initial_admin_password')"
    bashio::log.info "Initial admin: ${admin_email} (password from app config)"
fi

export INITIAL_ADMIN_EMAIL="${admin_email}"
export INITIAL_ADMIN_PASSWORD="${admin_pass}"

# --- Start NPMplus ---
bashio::log.info "NPMplus starting..."

cd /app
exec /usr/local/bin/entrypoint.sh
