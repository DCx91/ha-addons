#!/usr/bin/with-contenv bashio
bashio::log.info "Setting up persistent ASK CLI credential store..."

mkdir -p /data/.ask

if [ -L /root/.ask ]; then
    bashio::log.debug "/root/.ask symlink already present, skipping."
elif [ -d /root/.ask ]; then
    bashio::log.info "Migrating existing /root/.ask into /data/.ask..."
    cp -a /root/.ask/. /data/.ask/ 2>/dev/null || true
    rm -rf /root/.ask
    ln -s /data/.ask /root/.ask
else
    ln -s /data/.ask /root/.ask
fi

bashio::log.info "Successfully linked /root/.ask -> /data/.ask. Credentials will persist across restarts."
