+++ b/frontend/src/ingress.ts	2026-10-22 11:18:03.087407269 +0000
@@ -0,0 +1,8 @@
+// Home Assistant ingress serves the UI under /api/hassio_ingress/<token>/.
+// Absolute URLs like "/images/foo.svg" escape that prefix and hit HA core (404),
+// so static assets from public/ must be resolved against the ingress prefix at runtime.
+const match = window.location.pathname.match(/^(\/api\/hassio_ingress\/[^/]+)/);
+
+export const BASE_PATH: string = match ? `${match[1]}/` : "/";
+
+export const asset = (path: string): string => `${BASE_PATH}${path.replace(/^\/+/, "")}`;
