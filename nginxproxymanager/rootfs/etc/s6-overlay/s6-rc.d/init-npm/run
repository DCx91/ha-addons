#!/command/with-contenv bashio
# shellcheck shell=bash

ROOT_TOP="/config/nginx/custom/root_top.conf"
HTTP_TOP="/config/nginx/custom/http_top.conf"
GEOIP2_CONF="/config/geoip2/geoip2.conf"

mkdir -p \
    /config/access \
    /config/custom_ssl \
    /config/geoip2 \
    /config/letsencrypt \
    /config/letsencrypt-acme-challenge \
    /config/logs \
    /config/nginx/custom \
    /config/nginx/dead_host \
    /config/nginx/default_host \
    /config/nginx/default_www \
    /config/nginx/proxy_host \
    /config/nginx/redirection_host \
    /config/nginx/stream \
    /config/nginx/temp \
    /tmp/letsencrypt-lib \
    /tmp/letsencrypt-log \
    /tmp/nginx/body \
    /tmp/nginx/cache/private\
    /tmp/nginx/cache/public \
    /tmp/nginx/proxy \
    /var/lib/nginx/

# Enable/disable logging of successful requests
if bashio::config.true 'verbose'; then
    cat > "$HTTP_TOP" <<'EOF'
map $status $loggable {
    default 1;
}
EOF
else
    cat > "$HTTP_TOP" <<'EOF'
map $status $loggable {
    ~^[23] 0;
    default 1;
}
EOF
fi

# Remove any existing GeoIP2 load_module lines.
if [ -f "$ROOT_TOP" ]; then
    sed -i \
        -e '\|load_module /usr/lib/nginx/modules/ngx_http_geoip2_module.so;|d' \
        -e '\|load_module /usr/lib/nginx/modules/ngx_stream_geoip2_module.so;|d' \
        "$ROOT_TOP"
fi

if bashio::config.true 'geoip2'; then
    {
        echo "load_module /usr/lib/nginx/modules/ngx_http_geoip2_module.so;"
        echo "load_module /usr/lib/nginx/modules/ngx_stream_geoip2_module.so;"
    } >> "$ROOT_TOP"

    if [ ! -f "$GEOIP2_CONF" ]; then
        bashio::log.info "Creating default GeoIP2 config at $GEOIP2_CONF"
        cat > "$GEOIP2_CONF" <<'EOF'
# GeoIP2 lookup and allowlist.
# Requires MaxMind's GeoIP2 database: https://www.maxmind.com
# Edit the map block below to change which countries are allowed through.
# Then restart the app for changes to take effect.

geoip2 /config/geoip2/GeoLite2-country.mmdb {
    auto_reload 5m;
    $geoip2_data_country_code default=XX source=$remote_addr country iso_code;
}

# The below config alows connections from every country.
# Add country codes (e.g. RU no;) to blacklist connections from the listed countries.
# Or switch 'default' to 'no;' to block access from everywhere.
# Then add country codes (e.g. GB yes;) to whitelist connections from the listed countries.
map $geoip2_data_country_code $allowed_country {
    default yes;
    
    }
EOF
    fi

    if [ -f /config/geoip2/*.mmdb ]; then
        echo "include $GEOIP2_CONF;" >> "$HTTP_TOP"
    else
        bashio::log.warning "GeoIP2 enabled but no .mmdb file was found in /config/geoip2 - skipping"
    fi
fi

ln -s /tmp/nginx /var/tmp/nginx
ln -s /tmp/nginx /var/lib/nginx/tmp
ln -s /config /opt/nginx-proxy-manager/config

ln -sf /config/letsencrypt /etc/letsencrypt

# Nginx needs this file to be able to start.
# It will not continously log into it.
mkdir -p /var/lib/nginx/logs
touch /var/lib/nginx/logs/error.log
chmod 777 /var/lib/nginx/logs/error.log


# This file generates a dummy SSL certificate
if ! bashio::fs.directory_exists "/config/nginx/dummycert.pem" && ! bashio::fs.file_exists "/config/nginx/dummykey.pem";
then
  bashio::log.info "Generating dummy SSL certificate"
  openssl req \
    -new \
    -newkey rsa:2048 \
    -days 3650 \
    -nodes \
    -x509 \
    -subj '/O=Nginx Proxy Manager/OU=Dummy Certificate/CN=localhost' \
    -keyout /config/nginx/dummykey.pem \
    -out /config/nginx/dummycert.pem \
    || bashio::exit.nok "Could not generate dummy certificate"
fi
