#!/command/execlineb -P
foreground { mkdir -p /data/redis /data/addon }
pipeline -w { awk "!/Memory overcommit must be enabled|does not require authentication/ { print; fflush() }" }
redis-server
    --daemonize no
    --bind 127.0.0.1
    --port 6379
    --dir /data/redis
    --loglevel warning
    --appendonly no
    --save ""
    --maxmemory 32mb
    --maxmemory-policy allkeys-lfu
    --lazyfree-lazy-eviction yes
