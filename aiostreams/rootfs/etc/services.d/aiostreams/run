#!/usr/bin/with-contenv bashio

# Persistent storage
mkdir -p /data

# Auto-generate secret key and persist it to /data/secret_key.
bashio::log.info "Checking secret key..."
SECRET_KEY_FILE="/data/secret_key"
if [[ -f "${SECRET_KEY_FILE}" ]]; then
	SECRET_KEY=$(cat "${SECRET_KEY_FILE}")
	bashio::log.info "Using existing auto-generated secret key from ${SECRET_KEY_FILE}."
else
	bashio::log.info "Generating new secret key..."
	SECRET_KEY=$(openssl rand -hex 32)
	(umask 077; echo "${SECRET_KEY}" > "${SECRET_KEY_FILE}" )
	bashio::log.info "Generated new secret key and saved to ${SECRET_KEY_FILE}."
fi

# AIOStreams Auth
ADDON_USERNAME=$(bashio::config 'addon_username')
ADDON_PASSWORD=$(bashio::config 'addon_password')

# Map app options to AIOStreams environment variables
bashio::log.info "Reading configuration..."

set -a
AIOSTREAMS_AUTH="${ADDON_USERNAME}:${ADDON_PASSWORD}"
AIOSTREAMS_AUTH_REQUIRED=true
BASE_URL=$(bashio::config 'base_url')
DATABASE_URI="sqlite:///data/db.sqlite"
DEFAULT_MAX_CACHE_SIZE=2000
SQL_CACHE_MAX_SIZE=2000
DISK_CACHE_DIR=/tmp/cache
LOG_BUFFER_MAX_BYTES=16777216
LOG_BUFFER_MAX_ENTRIES=500
LOG_LEVEL=$(bashio::config 'verbosity')
NODE_OPTIONS="--max-old-space-size=384"
SECRET_KEY=${SECRET_KEY}
SETTINGS_REFRESH_INTERVAL=0

# Trakt Client ID & aliases
if bashio::config.has_value 'trakt_id'; then
    TRAKT_CLIENT_ID="$(bashio::config 'trakt_id')"
    FETCH_TRAKT_ALIASES=true
fi

# Anime API
bashio::config.false 'anime_api' && ANIME_DB_LEVEL_OF_DETAIL=none

# Trusted UUID
bashio::config.has_value 'trusted_uuid' && TRUSTED_UUIDS="$(bashio::config 'trusted_uuid')"
set +a

# Log basic info
if [[ "${LOG_LEVEL}" = "error" || "${LOG_LEVEL}" = "warning" ]]; then
	log_output() {
    	bashio::log.info "$(printf '%-15s: %s' "$1" "$2")"
	}

	log_output "Base URL" "${BASE_URL}"
	log_output "Database" "${DATABASE_URI}"
	log_output "Log Level" "${LOG_LEVEL}"
	log_output "Anime DB" "$(bashio::config 'anime_api')"
	log_output "Trakt" "$(bashio::config.has_value 'trakt_id' && echo 'configured' || echo 'unconfigured')"
	log_output "Trusted UUID" "$(bashio::config.has_value 'trusted_uuid' && echo 'configured' || echo 'unconfigured')"
fi

# Start AIOStreams
bashio::log.info "Starting AIOStreams..."
cd /app
exec node packages/server/dist/server.js > >(jq -R -r --unbuffered -f /etc/aiostreams.jq) 2>&1
