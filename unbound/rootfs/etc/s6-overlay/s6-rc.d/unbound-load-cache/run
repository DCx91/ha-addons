#!/usr/bin/with-contenv bashio

UNBOUND_CONF="/config/unbound.conf"
CACHE_DUMP="/config/unbound_cache.dump"
INTERVAL=$(bashio::config 'cache_interval' '600')
DUMP_TIMEOUT=30

if ! bashio::config.true 'persist_cache'; then
    bashio::log.info "Cache persistence disabled; not running."
    s6-svc -O .
    bashio::exit.ok
fi

format_interval() {
    local total="${1}"
    local h=$(( total / 3600 ))
    local m=$(( (total % 3600) / 60 ))
    local s=$(( total % 60 ))
    local parts=()

    (( h > 0 )) && parts+=("${h} hour$( (( h != 1 )) && echo s)")
    (( m > 0 )) && parts+=("${m} minute$( (( m != 1 )) && echo s)")
    (( s > 0 )) && parts+=("${s} second$( (( s != 1 )) && echo s)")

    case "${#parts[@]}" in
        1) echo "${parts[0]}" ;;
        2) echo "${parts[0]} and ${parts[1]}" ;;
        3) echo "${parts[0]}, ${parts[1]} and ${parts[2]}" ;;
    esac
}

dump_cache() {
    local tmp="${CACHE_DUMP}.tmp"

    # Skip if Unbound isn't responding
    if ! unbound-control -c "${UNBOUND_CONF}" status > /dev/null 2>&1; then
        bashio::log.debug "Cache dump skipped - Unbound not responding."
        return 0
    fi

    # Write to a temp file and move it on success
    if timeout "${DUMP_TIMEOUT}" unbound-control -c "${UNBOUND_CONF}" dump_cache > "${tmp}" \
        && bashio::fs.file_non_empty "${tmp}"; then
        mv "${tmp}" "${CACHE_DUMP}"
        bashio::log.debug "Cache saved to ${CACHE_DUMP}."
    else
        rm -f "${tmp}"
        bashio::log.warning "Cache dump failed or timed out; keeping previous dump."
    fi
}

bashio::log.info "Saving the cache every $(format_interval "${INTERVAL}")."

final_dump() { dump_cache; exit 0; }
trap final_dump TERM

while true; do
    sleep "${INTERVAL}" &
    wait $!
    dump_cache
done
